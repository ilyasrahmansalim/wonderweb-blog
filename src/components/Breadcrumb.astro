---
export interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-onyx/50">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {item.href ? (
          <a href={item.href} class="hover:text-ocean">{item.label}</a>
        ) : (
          <span class="text-onyx/80" aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span class="mx-1 text-onyx/30">/</span>}
      </li>
    ))}
  </ol>
</nav>
