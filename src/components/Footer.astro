---
const year = new Date().getFullYear();
const columns = [
  {
    title: 'Navigasi',
    links: [
      { label: 'Beranda', href: '/' },
      { label: 'Blog', href: '/blog' },
      { label: 'Tentang Wonderweb', href: '/about' },
    ],
  },
  {
    title: 'Kategori',
    links: [
      { label: 'Web Development', href: '/blog?category=web-development' },
      { label: 'SEO & GEO', href: '/blog?category=seo' },
      { label: 'Branding', href: '/blog?category=branding' },
    ],
  },
  {
    title: 'Kontak',
    links: [
      { label: 'hello@wonderweb.id', href: 'mailto:hello@wonderweb.id' },
      { label: 'Instagram', href: 'https://instagram.com/wonderweb.id' },
      { label: 'LinkedIn', href: 'https://linkedin.com/company/wonderweb' },
    ],
  },
];
---

<footer class="border-t border-onyx/5 bg-onyx text-ghost">
  <div class="container-wonder grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <a href="/" class="flex items-center gap-2 text-lg font-extrabold">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky text-sm text-onyx">W</span>
        Wonderweb
      </a>
      <p class="mt-3 max-w-xs text-sm text-ghost/60">
        Web that wonders. Studio web development independen untuk landing page dan frontend berkualitas tinggi.
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <h3 class="text-sm font-semibold text-ghost/50">{col.title}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {col.links.map((link) => (
            <li><a href={link.href} class="text-ghost/80 transition hover:text-sky">{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-ghost/10">
    <div class="container-wonder flex flex-col items-center justify-between gap-3 py-6 text-xs text-ghost/50 sm:flex-row">
      <p>&copy; {year} Wonderweb. Seluruh hak cipta dilindungi.</p>
      <p>Dibangun dengan Astro &amp; DaisyUI.</p>
    </div>
  </div>
</footer>
