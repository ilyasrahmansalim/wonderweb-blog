---
import MainLayout from '../layouts/MainLayout.astro';

const values = [
  {
    title: 'Kualitas di atas kuantitas',
    desc: 'Kami memilih mengerjakan sedikit proyek dengan hasil terbaik, dibanding banyak proyek dengan hasil biasa saja.',
  },
  {
    title: 'Performa adalah fitur',
    desc: 'Website yang cepat bukan bonus — itu standar. Setiap proyek dioptimalkan untuk Core Web Vitals.',
  },
  {
    title: 'Desain yang bekerja',
    desc: 'Estetika minimal dan premium yang tetap fokus pada satu tujuan: membantu bisnis klien bertumbuh.',
  },
  {
    title: 'Transparan & mudah diajak kerja sama',
    desc: 'Komunikasi jelas, proses simpel, dan hasil yang bisa diukur — tanpa jargon yang membingungkan.',
  },
];
---

<MainLayout
  title="Tentang Wonderweb"
  description="Wonderweb adalah studio web development independen yang fokus membangun landing page dan frontend berkualitas tinggi untuk bisnis yang sedang bertumbuh."
>
  <section class="container-wonder py-16 sm:py-24">
    <div class="max-w-3xl">
      <span class="badge badge-outline border-ocean/30 text-ocean">Tentang Kami</span>
      <h1 class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight text-onyx sm:text-5xl">
        Studio kecil, standar tinggi.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-onyx/65">
        Wonderweb adalah studio web development independen yang berfokus pada landing page dan pekerjaan frontend
        berkualitas tinggi. Kami membantu bisnis Indonesia — dan ke depannya klien internasional — memiliki
        website yang cepat, rapi, dan benar-benar mendukung pertumbuhan mereka.
      </p>
    </div>
  </section>

  <section class="container-wonder grid gap-10 pb-16 sm:grid-cols-2">
    <div class="glass rounded-box border border-onyx/5 p-8">
      <h2 class="text-xl font-semibold text-onyx">Visi</h2>
      <p class="mt-3 text-sm leading-relaxed text-onyx/60">
        Menjadi studio web development independen yang paling dipercaya oleh bisnis yang sedang bertumbuh, dengan
        standar kualitas dan performa setara agensi internasional.
      </p>
    </div>
    <div class="glass rounded-box border border-onyx/5 p-8">
      <h2 class="text-xl font-semibold text-onyx">Misi</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-onyx/60">
        <li>Membangun website yang cepat, rapi, dan mudah dirawat.</li>
        <li>Mengutamakan hasil nyata bagi bisnis klien, bukan sekadar tampilan.</li>
        <li>Membagikan ilmu web development lewat blog dan konten edukasi.</li>
      </ul>
    </div>
  </section>

  <section class="container-wonder pb-16">
    <h2 class="mb-8 text-2xl font-semibold text-onyx sm:text-3xl">Nilai yang Kami Pegang</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {values.map((v) => (
        <div class="rounded-box border border-onyx/5 bg-base-100 p-6">
          <h3 class="font-semibold text-onyx">{v.title}</h3>
          <p class="mt-2 text-sm text-onyx/60">{v.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wonder pb-20">
    <div class="glass rounded-box flex flex-col items-center gap-4 border border-onyx/5 px-6 py-12 text-center sm:px-12">
      <h2 class="max-w-xl text-2xl font-semibold text-onyx sm:text-3xl">Mari bangun sesuatu yang berkualitas.</h2>
      <p class="max-w-lg text-sm text-onyx/60">
        Cerita tentang proyekmu, dan kita cari tahu bersama cara terbaik untuk mewujudkannya.
      </p>
      <a href="https://wonderweb.id" class="btn btn-primary rounded-btn mt-2">Hubungi Wonderweb</a>
    </div>
  </section>
</MainLayout>
