---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import BlogSearch from '../../components/BlogSearch.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);

const categories = [...new Set(allPosts.map((p) => p.data.category))];
const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

const featured = allPosts[0];
const rest = allPosts.slice(1);
---

<MainLayout
  title="Blog Wonderweb — Semua Artikel"
  description="Kumpulan artikel Wonderweb seputar web development, Astro, SEO, GEO, branding, dan strategi landing page."
>
  <section class="container-wonder py-14 sm:py-20">
    <span class="badge badge-outline border-ocean/30 text-ocean">Blog</span>
    <h1 class="mt-5 text-4xl font-bold leading-[1.1] tracking-tight text-onyx sm:text-5xl">
      Semua Artikel
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-onyx/60">
      Panduan praktis seputar web development, desain, dan pertumbuhan bisnis digital.
    </p>
  </section>

  <section class="container-wonder pb-20">
    <BlogSearch categories={categories} tags={tags} />

    {featured && (
      <div
        class="mb-6"
        data-post-card
        data-title={featured.data.title.toLowerCase()}
        data-category={featured.data.category}
        data-tags={featured.data.tags.join(',')}
      >
        <PostCard
          slug={featured.slug}
          title={featured.data.title}
          description={featured.data.description}
          featuredImage={featured.data.featuredImage}
          featuredImageAlt={featured.data.featuredImageAlt}
          category={featured.data.category}
          publishedDate={featured.data.publishedDate}
          readingTime={featured.data.readingTime}
          featured
        />
      </div>
    )}

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" id="posts-grid">
      {rest.map((post) => (
        <div
          data-post-card
          data-title={post.data.title.toLowerCase()}
          data-category={post.data.category}
          data-tags={post.data.tags.join(',')}
        >
          <PostCard
            slug={post.slug}
            title={post.data.title}
            description={post.data.description}
            featuredImage={post.data.featuredImage}
            featuredImageAlt={post.data.featuredImageAlt}
            category={post.data.category}
            publishedDate={post.data.publishedDate}
            readingTime={post.data.readingTime}
          />
        </div>
      ))}
    </div>

    <div id="blog-empty-state" class="hidden py-16 text-center text-onyx/50">
      Tidak ada artikel yang cocok dengan pencarianmu.
    </div>

    <div class="mt-12 flex justify-center">
      <div class="join">
        <button class="btn join-item btn-sm" disabled>&laquo;</button>
        <button class="btn join-item btn-sm btn-active">1</button>
        <button class="btn join-item btn-sm" disabled>&raquo;</button>
      </div>
    </div>
  </section>

  <Newsletter />
</MainLayout>

<style>
  #blog-empty-state.hidden {
    display: none;
  }
</style>
